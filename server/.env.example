# ===============================================
# SERVER ENVIRONMENT CONFIGURATION
# ===============================================

# Port backend lắng nghe (Mặc định cloud platforms như Render/Heroku sẽ tự động gán PORT)
PORT=5000

# Môi trường chạy: 'development' hoặc 'production'
NODE_ENV=development

# MongoDB Connection String:
# - Development: mongodb://127.0.0.1:27017/smarthotel
# - Production: mongodb+srv://<username>:<password>@cluster.mongodb.net/smarthotel?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/smarthotel

# Client URL whitelist cho CORS (phân cách bằng dấu phẩy nếu có nhiều domain)
# - Development: http://localhost:3000
# - Production (Deploy riêng): https://smarthotel.vercel.app,https://smarthotel.netlify.app
CLIENT_URL=http://localhost:3000

# JWT Authentication
JWT_SECRET=smarthotel_jwt_secret_super_secure_key_change_in_production
JWT_EXPIRE=7d

# Cloudinary (Quản lý ảnh khách sạn & phòng)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini AI (Trợ lý ảo & đề xuất thông minh)
GEMINI_API_KEY=your_gemini_api_key
